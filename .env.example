# Copia este archivo como .env (no lo subas al repositorio)

# Secreto compartido por el backend Java y el mock Node para firmar/validar JWT.
# Mínimo 32 caracteres. Genera uno con:  openssl rand -base64 48
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria-de-32+

# Contraseña de PostgreSQL
POSTGRES_PASSWORD=touristchain

# "dev" carga usuarios y destinos de demostración; usa "prod" para no cargarlos
SPRING_PROFILES_ACTIVE=dev
