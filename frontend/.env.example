# Copia este archivo como .env y ajusta los valores
# NUNCA subas el .env real al repositorio

# --- Mock Node (npm run server) ---
# Secreto para validar los tokens JWT. DEBE ser el mismo valor que usa el backend Java
# (variable JWT_SECRET), porque el login lo hace Java. Mínimo 32 caracteres.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria-de-32+

# Puerto del mock (por defecto 3001)
PORT=3001

# --- Frontend (npm run dev / npm run build) ---
# Backend Java (Spring Boot)
VITE_API_URL=http://localhost:8080/api/v1
# Mock Node: módulos aún no migrados a Java
VITE_MOCK_API_URL=http://localhost:3001/api
